[
  {
    "title":"PDF Upload Resize",
    "properties": [
      {
        "name": "id",
        "label": "ID",
        "type": "textfield",
        "required": "true"
      },
      {
        "name": "label",
        "label": "Label",
        "type": "textfield",
        "required": "false"
      },
      {
        "name" : "maxSize",
        "label" : "@@form.fileupload.maxSize@@",
        "type" : "textfield",
        "regex_validation" : "^[0-9]+$",
        "validation_message" : "@@form.fileupload.invalidSize@@"
      },
      {
        "name" : "maxSizeMsg",
        "label" : "@@form.fileupload.maxSize.msg@@",
        "type" : "textfield",
        "value" : "@@form.fileupload.maxSize.msg.fileTooBig@@"
      },
      {
        "name" : "fileType",
        "label" : "pdf",
        "type" : "hidden"
      },
      {
        "name": "compressionLevel",
        "label": "Compression Level",
        "type": "selectbox",
        "options": [
          {"value": "none", "label": "None (Original Quality)"},
          {"value": "low", "label": "Low (Better Quality, Larger File)"},
          {"value": "medium", "label": "Medium (Balanced)"},
          {"value": "high", "label": "High (Smallest Size, Lower Quality)"}
        ],
        "value": "none"
      },
      {
        "name": "enableWatermark",
        "label": "Enable Watermark",
        "type": "checkbox",
        "options": [{"value": "true", "label": ""}]
      },
      {
        "name": "watermarkText",
        "label": "Watermark Text",
        "type": "textfield",
        "value": "Kinnara Digital Studio",
        "control_field": "enableWatermark",
        "control_value": "true",
        "control_use_conjunction": "or"
      }
    ]
  }
]